# Docker Compose environment template
# Copy to docker/.env, then replace placeholder values.

# MySQL
MYSQL_DATABASE=ocrdb
MYSQL_USER=app_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Knowledge database accounts
KB_OWNER_PASSWORD=change-me-kb-owner
KB_INGEST_PASSWORD=change-me-kb-ingest
KB_READER_PASSWORD=change-me-kb-reader

# Shared authentication secrets
INTERNAL_API_TOKEN=change-me-internal-token
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
KB_INGEST_API_TOKEN=change-me-ingest-token

# Qdrant and embedding
QDRANT_API_KEY=change-me-qdrant-key
QDRANT_READ_ONLY_API_KEY=change-me-qdrant-readonly-key
EMBEDDING_API_KEY=

# Optional administrator bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional AI integrations
LLM_ADAPTERS=
CHECK_RULES_TOOL=MOCK
MSDS_TOOL=MOCK
KOSHA_MSDS_SERVICE_KEY=

# Optional mail integration
MAIL_MODE=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
WEB_BASE_URL=http://localhost:50001

# Optional Spring AI clients
APP_AGENT_CLIENT=fastapi
APP_EXTRACT_LLM_CLIENT=fastapi
APP_PHOTO_VISION_CLIENT=fastapi
APP_STT_CLIENT=fastapi
